{
  "name": "chembook3d-frontend",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.snapshot.config.ts && node scripts/bundle-budget.mjs",
    "lint": "oxlint --deny-warnings",
    "test:unit": "node --import ./tests/resolve-ts.mjs --test tests/*.test.mjs",
    "test:coverage": "node --import ./tests/resolve-ts.mjs --test --experimental-test-coverage --test-coverage-include=\"src/**\" tests/*.test.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "3dmol": "^2.5.5",
    "elkjs": "0.12.1",
    "events": "3.3.0",
    "html-to-image": "1.11.13",
    "ketcher-core": "3.18.0",
    "ketcher-react": "3.18.0",
    "ketcher-standalone": "3.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.92.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "miew-react": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "dpdm": {
      "glob": "^14.0.3"
    }
  }
}
